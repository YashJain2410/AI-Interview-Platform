# Server-side only. Restart the backend after changing settings.
# Exactly one provider/model is used. No automatic retries or model/provider fallback.
# Providers: google, openai, anthropic, groq, mistral, deepseek, xai,
# together, huggingface, openrouter, openai_compatible
LLM_PROVIDER=google
# LLM_MODEL takes precedence over provider-specific *_MODEL variables.
# Leave blank to use GEMINI_MODEL for Google (default: gemini-3.8-flash).
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_key_here
# GOOGLE_API_KEY is also accepted when GEMINI_API_KEY is absent.

LLM_TIMEOUT_SECONDS=60
LLM_QUESTION_MAX_TOKENS=1024
LLM_REPORT_MAX_TOKENS=4096
# Gemini 3 thinking: low, medium, high. No deprecated sampling controls.
GEMINI_THINKING_LEVEL=low
GEMINI_REPORT_THINKING_LEVEL=medium

# Set only the key for your chosen provider; select an explicit LLM_MODEL.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# HF_API_TOKEN=
# For huggingface, LLM_MODEL must include an explicit :provider suffix.
# OPENROUTER_API_KEY=
# OPENROUTER_PROVIDER=one-exact-upstream-slug

# Optional API root override; required for openai_compatible.
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=  # used only by openai_compatible
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
